# Backend-only Vercel AI Gateway key. Without credentials, use curated fallbacks.
# Vercel OIDC (VERCEL_OIDC_TOKEN) is also supported when provided by the runtime.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=deepseek/deepseek-v4.1-flash-1017
# Exact website origins, separated by commas. No paths or trailing slashes.
# Add your production website origin before connecting it to this backend.
ALLOWED_ORIGINS=http://localhost:3000

# Same Supabase project as the web and Swift clients.
SUPABASE_URL=https://hhovzaaeolcfynyetabf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Backend only: never prefix with NEXT_PUBLIC_ or commit this key.
SUPABASE_SECRET_KEY=

# Optional public HTTPS directory containing versioned MP4/JPG/VTT video files.
# Leave empty to serve the packaged pilots from this backend's /videos/.
VIDEO_ASSET_BASE_URL=

# Optional backend-only native YouTube captions provider. No NEXT_PUBLIC_ prefix.
# Without it, embed videos and import timed SRT/VTT captions in the web app.
SUPADATA_API_KEY=
