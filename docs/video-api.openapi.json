    "/api/visualizations": {
      "get": {
        "operationId": "getVisualizations",
        "summary": "Read native SVG stages for all topics or one topic",
        "parameters": [
          {
            "name": "topicId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Four ordered stages per topic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisualizationCatalog"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query"
          },
          "403": {
            "description": "Browser origin denied"
          },
          "404": {
            "description": "Unknown topic"
          },
          "503": {
            "description": "Invalid media-host configuration"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "studyChat",
        "summary": "Authenticated multi-turn tutor with explicit catalog or student-supplied YouTube transcript context",
        "description": "Authenticated multi-turn tutor with explicit catalog or student-supplied YouTube transcript context. Catalog passages are resolved server-side; whole transcript uses cueIndex:null. Context and recent history each have a 24,000 character budget. Chat is not persisted. YouTube supports playbackSeconds and a nullable numeric cueIndex for explicit focus. The backend derives currentPassage and selectedPassage from the supplied transcript. Clients must not send derived passages. Use transcriptScope=excerpt for long-video context windows.",
        "security": [
          {
            "supabaseBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudyChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyChatReply"
