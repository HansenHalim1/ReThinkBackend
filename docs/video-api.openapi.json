  "components": {
    "schemas": {
      "VideoCatalog": {
        "type": "object",
        "required": [
          "schemaVersion",
          "catalogVersion",
          "videos"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "catalogVersion": {
            "type": "string"
          },
          "videos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConceptVideo"
            }
          }
        }
      },
      "ConceptVideo": {
        "type": "object",
        "required": [
          "id",
          "version",
          "topicId",
          "skillIds",
          "title",
          "summary",
          "language",
          "durationSeconds",
          "renderer",
          "hasAudio",
          "width",
          "height",
          "mimeType",
          "videoUrl",
          "posterUrl",
          "captionsUrl",
          "transcript"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "topicId": {
            "type": "string"
          },
          "skillIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "renderer": {
            "type": "string"
          },
          "hasAudio": {
            "type": "boolean"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "video/mp4"
            ]
          },
          "videoUrl": {
            "type": "string",
            "format": "uri"
          },
          "posterUrl": {
            "type": "string",
            "format": "uri"
          },
          "captionsUrl": {
            "type": "string",
            "format": "uri"
          },
          "transcript": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptCue"
            }
          }
        }
      },
      "TranscriptCue": {
        "type": "object",
        "required": [
          "startSeconds",
          "endSeconds",
          "text"
        ],
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "VideoHelpRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "videoId",
          "videoVersion",
          "cueIndex",
          "question"
        ],
        "properties": {
          "videoId": {
            "type": "string"
          },
          "videoVersion": {
            "type": "integer",
            "minimum": 1
          },
          "cueIndex": {
            "type": "integer",
            "minimum": 0
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      },
      "VideoHelpResponse": {
        "type": "object",
        "required": [
          "videoId",
          "videoVersion",
          "cueIndex",
          "explanation",
          "source"
        ],
        "properties": {
          "videoId": {
            "type": "string"
          },
          "videoVersion": {
            "type": "integer"
          },
          "cueIndex": {
            "type": "integer"
          },
          "explanation": {
            "type": "string",
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "enum": [
              "gateway",
              "curated"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Present for curated fallback: not-configured, invalid-configuration, invalid-api-key, credits-exhausted, model-access-denied, rate-limited, provider-unavailable, or invalid-response."
          },
          "model": {
            "type": "string",
            "description": "Configured DeepSeek Gateway model identifier; does not prove a live provider call succeeded."
          }
        }
      },
      "VisualizationCatalog": {
        "type": "object",
        "required": [
          "schemaVersion",
          "catalogVersion",
          "visualizations"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "catalogVersion": {
            "type": "string"
          },
          "visualizations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "version",
                "topicId",
                "title",
                "question",
                "takeaway",
                "interaction",
                "width",
                "height",
                "parameter",
                "stages"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "topicId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "takeaway": {
                  "type": "string"
                },
                "interaction": {
                  "const": "stage-selector"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                },
                "parameter": {
                  "type": "object",
                  "required": [
                    "label",
                    "min",
                    "max",
                    "step",
                    "initial"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number"
                    },
                    "initial": {
                      "type": "number"
                    }
                  }
                },
                "stages": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": [
                      "index",
                      "value",
                      "caption",
                      "result",
                      "svgUrl"
                    ],
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "value": {
                        "type": "number"
                      },
                      "caption": {
                        "type": "string"
                      },
                      "result": {
                        "type": "string"
                      },
                      "svgUrl": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "CatalogChatContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "catalog"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "cueIndex": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        },
        "required": [
          "kind",
          "id",
          "version",
          "cueIndex"
        ]
      },
      "ChatTranscriptCue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "maximum": 86400
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "startSeconds",
          "endSeconds",
          "text"
        ]
      },
      "YouTubeChatContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "youtube"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cueIndex": {
            "type": "integer",
            "minimum": 0,
            "nullable": true,
            "description": "Optional explicit focus index in the supplied transcript; null uses the current playback passage."
          },
          "transcript": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3000,
            "items": {
              "$ref": "#/components/schemas/ChatTranscriptCue"
            }
          },
          "playbackSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400,
            "description": "Snapshot of current player time in seconds when the student submits the question."
          },
          "transcriptScope": {
            "type": "string",
            "enum": [
              "full",
              "excerpt"
            ],
            "default": "full",
            "description": "Long videos may send relevant excerpts around playback and explicit focus within the context budget."
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "cueIndex",
          "transcript"
        ]
      },
      "StudyChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "messages": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CatalogChatContext"
              },
              {
                "$ref": "#/components/schemas/YouTubeChatContext"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          }
        },
        "required": [
          "question",
          "messages"
        ]
      },
      "StudyChatReply": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 6000
          },
          "source": {
            "type": "string",
            "enum": [
              "gateway",
              "curated"
            ]
          },
          "model": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "answer",
          "source"
        ]
      },
      "YouTubeTranscriptRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "id"
            ],
            "default": "en",
            "description": "Preferred native caption language; mismatched provider fallback returns 422."
          }
        },
        "required": [
          "url"
        ]
      },
      "YouTubeTranscriptReply": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "id"
            ]
          },
          "transcriptOrigin": {
            "type": "string",
            "enum": [
              "provider"
            ]
          },
          "transcript": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3000,
            "items": {
              "$ref": "#/components/schemas/ChatTranscriptCue"
            }
          }
        },
        "required": [
          "id",
          "title",
          "language",
          "transcriptOrigin",
          "transcript"
        ]
      }
    },
    "securitySchemes": {
      "supabaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token from the same project used by web."
      }
    }
  }
}
