{
  "openapi": "3.0.3",
  "info": {
    "title": "ReThink concept media and study chatbot",
    "version": "1.5.0",
    "description": "39 topic videos and public, captioned native visualization stages. Videos are silent with Indonesian captions. Synchronized transcripts, authenticated chat context and YouTube native caption import."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local demo"
    },
    {
      "url": "https://rethinkbackend.vercel.app",
      "description": "Production after deployment"
    }
  ],
  "paths": {
    "/api/videos": {
      "get": {
        "operationId": "listConceptVideos",
        "summary": "List public Manim concept videos",
        "security": [],
        "parameters": [
          {
            "name": "topicId",
            "in": "query",
            "required": false,
            "description": "Omit for all pilots. Known topic with no clip returns an empty array. Pilot topic IDs: distribution, x-quadratic, advanced-derivatives.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public catalog. No account data. Media URLs are absolute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoCatalog"
                }
              }
            }
          },
          "400": {
            "description": "Request or service error",
